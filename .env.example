# Canonical Site Domain (for SEO, Sitemap, Robots & JSON-LD)
NEXT_PUBLIC_SITE_URL=https://my-football-yusto.vercel.app

# Football Live Score API Configuration
# Choose provider: "api-football" | "football-data" | "demo"
NEXT_PUBLIC_DEFAULT_PROVIDER=football-data

# Option 1: API-Football (https://www.api-football.com / RapidAPI / api-sports.io)
# Endpoint: https://v3.football.api-sports.io
API_FOOTBALL_KEY=

# Option 2: Football-Data.org (https://www.football-data.org)
# Endpoint: https://api.football-data.org/v4
# Free tier: 12 major competitions, 10 req/min (heavily cached server-side)
FOOTBALL_DATA_API_KEY=38d1772583564a42aa61e043f5a313d4
